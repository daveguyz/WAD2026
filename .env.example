# Copy this file to .env and adjust for your machine
PORT=3000
NODE_ENV=development

# MySQL / MariaDB connection (XAMPP default: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campuspulse

# Long random string used to sign session cookies
SESSION_SECRET=change-this-to-a-long-random-string
